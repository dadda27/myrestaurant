#currImg {

}

.arrows {
  position: absolute;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 50vh;
}

.arrow {
  padding: 2%;
  width: auto;
}

.arrow:hover {
  background-color: rgba(242, 242, 242, 0.3);
  transition: 0.3s ease-in-out;
}

.arrow i {
  font-size: 50px;
  color: #FFF;
  cursor: pointer;
}

.arrow i:hover {
  background-color: rgba(0, 0, 0, 0.1);
  transition: 0.3s ease-in-out;
}

.arrow-left  {

}

.arrow-right  {
}

.carousel-message {
  position: absolute;
  width: 250px;
  margin: 67vh 10vw 10vh 60vw;
  font-family: 'Dancing Script', cursive;
  font-size: 19px;
  color: #FFF;
  text-align: center;
  box-shadow: 0 20px 20px rgb(0,0,0,0.5);
  transform: translateZ(200px);
  border-radius: 30%;
  background-color: rgba(146, 154, 146, 0.5);
  padding: 2%;
  //box-shadow: 10px 5px 5px black;
}

.welcome-wrapper {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 5%;
  background-color: #000;
  background-image: url("../img/logo.jpg");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-attachment: scroll;
}

.welcome {
  text-align: center;
  padding: 10%;
  margin: auto;
  border-radius: 20px;
}


.welcome h1 {
  color: RGBA(200,15,15, 1);
  font-size: 20px;
  font-family: 'Alfa Slab One', cursive;
}

.after-welcome-wrapper {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 5%;
  background-image: url("../img/62.jpg");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-attachment: fixed;
  display: flex;
  justify-content: center;
  align-items: center;
}

.after-welcome h1 {
  font-size: 50px;
  color: RGBA(255,255,255, 1);
  font-family: 'Alfa Slab One', cursive;
  text-shadow: -0.5px 0 #F6F6F6;
}

