@font-face {
  src: url(../FONT/norwester.otf);
  font-family: norwester;
}

@font-face {
  src: url(../FONT/Notera_PersonalUseOnly.ttf);
  font-family: notera;
}

*{
  margin: 0;
  top: 0;
  padding: 0;
}

html, body {
  overflow-x: hidden;
  top: 0;
  bottom: 0;
}

.contactos-wrapper {
  //border: solid;
  //background-color: rgba(0, 0, 0, 0.8);
  margin-top: 100px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.contacto {
  //background-color: rgba(255, 255, 255, 1);
  border: solid;
  border-radius: 10px;
  width: 80%;
  height: 50vh;
  margin-bottom: 10px;
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.contacto-text {
  justify-content: space-around;
  text-align: center;
  background-color: black;
  color: white;
  font-family: norwester;
  font-size: 25px;
}

.link-maps .fa-map-marker {
  color: red;
}

.link-maps a {
  text-decoration: none;
  color: green;
}

.fab {
  font-size: 150px;
}

.fa-facebook-square {
  text-shadow: 0 20px 20px rgb(0,0,0,0.5);
  color: RGB(66 103 178);
  transform: translateZ(100px);
}

.fa-twitter {
  text-shadow: 0 20px 20px rgb(0,0,0,0.5);
  color: RGB(29,161,242);
  transform: translateZ(100px);
}

.fa-instagram {
  color: transparent;
  background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
  background: -webkit-radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
  background-clip: text;
  -webkit-background-clip: text;
  text-shadow: 0 20px 20px rgb(0,0,0,0.4);
  transform: translateZ(100px);
}
